{
  "name": "library-management-app",
  "version": "1.0.0",
  "private": true,
  "description": "Система управління бібліотекою",
  "scripts": {
    "build": "vite build",
    "start": "vite --host localhost --port 9000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"src/**/*.scss\" \"tests/**/*.ts\" \"*.{js,json}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"src/**/*.scss\" \"tests/**/*.ts\" \"*.{js,json}\"",
    "test": "mocha --require tsx/cjs \"tests/**/*.test.ts\"",
    "prepare": "husky"
  },
  "dependencies": {
    "bootstrap": "^5.3.8"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.5.1",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "chai": "^6.2.2",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "mocha": "^12.0.1",
    "prettier": "^3.9.6",
    "sass": "^1.93.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  }
}
